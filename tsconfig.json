{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "typeRoots": [
      "./node_modules/.pnpm/@types+react@19.2.14/node_modules/@types",
      "./node_modules/@types"
    ],
    "paths": {
      "react": ["./node_modules/.pnpm/@types+react@19.2.14/node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/.pnpm/@types+react@19.2.14/node_modules/@types/react/*"]
    }
  },
  "include": ["src"]
}
